# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# RAG: generated embeddings index (rebuild with rag/scripts/build-rag-index.mjs)
# and raw source docs (PDFs / extracted text) staged for indexing.
/rag/worker/src/index-data.json
/rag/worker/src/index-data.dryrun.json
/rag/sources/
!/rag/sources/.gitkeep
/rag/worker/.wrangler/
/rag/worker/node_modules/
/rag/worker/.dev.vars
/rag/worker/dist/

# Vite build output for the React rewrite (app/). The published site is
# still docs/index.html, generated from design/avinash-console.html.
app/dist/
